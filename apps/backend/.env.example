DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interviewer?schema=public"
GEMINI_API_KEY="your-gemini-api-key"
PORT=4001

# Gemini Live (real-time voice interview)
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-latest"
GEMINI_LIVE_VOICE="Kore"

# Gemini scoring (falls back to GEMINI_FALLBACK_MODELS on 503/429/404)
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODELS="gemini-flash-latest,gemini-flash-lite-latest"

# Optional
PROXY_URL=""
GITHUB_TOKEN=""
